{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "messenger",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define",
                "APP_ENVIRONMENT_NAME=local",
                "--dart-define",
                "APP_AUTH_BASE_URL=http://localhost:80/auth/api/v1",
                "--dart-define",
                "APP_CHAT_BASE_URL=http://localhost:80/room/api/v1",
                "--dart-define",
                "APP_FILE_BASE_URL=http://localhost:80/file",
                "--dart-define",
                "APP_WS_BASE_URL=ws://localhost:80/room/ws"
            ]
        },
        {
            "name": "messenger (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "messenger (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}